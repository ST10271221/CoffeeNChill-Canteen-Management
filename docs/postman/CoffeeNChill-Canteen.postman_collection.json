{
  "info": {
    "_postman_id": "coffeenchill-canteen-api",
    "name": "CoffeeNChill Canteen API",
    "description": "Postman collection for the CoffeeNChill Azure Functions API running against the local Docker and Azurite environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7071/api"
    }
  ],
  "item": [
    {
      "name": "Menu",
      "item": [
        {
          "name": "Create Menu Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Cappuccino\",\n  \"description\": \"Postman test menu item\",\n  \"price\": 32.50,\n  \"category\": \"Beverages\",\n  \"sku\": \"PST-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            }
          }
        },
        {
          "name": "Get All Menu Items",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            }
          }
        },
        {
          "name": "Get Menu Items By Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/menu/category/{{menuCategory}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu",
                "category",
                "{{menuCategory}}"
              ]
            }
          }
        },
        {
          "name": "Update Menu Item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Test Cappuccino\",\n  \"price\": 35.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/menu/{{menuCategory}}/{{menuSku}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu",
                "{{menuCategory}}",
                "{{menuSku}}"
              ]
            }
          }
        },
        {
          "name": "Delete Menu Item",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/menu/{{menuCategory}}/{{menuSku}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu",
                "{{menuCategory}}",
                "{{menuSku}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Staff Documents",
      "item": [
        {
          "name": "Upload Staff Document",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "upload"
              ]
            }
          }
        },
        {
          "name": "List Staff Documents",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            }
          }
        },
        {
          "name": "Download Staff Document",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/documents/download/{{documentFileName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "download",
                "{{documentFileName}}"
              ]
            }
          }
        }
      ]
    }
  ]
}