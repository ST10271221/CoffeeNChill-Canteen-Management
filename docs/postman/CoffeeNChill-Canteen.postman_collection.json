{
  "info": {
    "_postman_id": "coffeenchill-canteen-api",
    "name": "CoffeeNChill Canteen API",
    "description": "Postman collection for the CoffeeNChill Azure Functions API running against the local Docker and Azurite environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7071/api"
    }
  ],
  "item": [
    {
      "name": "Menu",
      "item": [
        {
          "name": "Create Menu Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Menu create endpoint requires Function authentication\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-functions-key",
                "value": "{{functionKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Cappuccino\",\n  \"description\": \"Postman test menu item\",\n  \"price\": 32.50,\n  \"category\": \"Beverages\",\n  \"sku\": \"PST-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            }
          }
        },
        {
          "name": "Get All Menu Items",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Menu endpoint requires Function authentication\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-functions-key",
                "value": "{{functionKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            }
          }
        },
        {
          "name": "Get Menu Items By Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Menu category endpoint requires Function authentication\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-functions-key",
                "value": "{{functionKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/menu/category/{{menuCategory}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu",
                "category",
                "{{menuCategory}}"
              ]
            }
          }
        },
        {
          "name": "Update Menu Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Menu update endpoint requires Function authentication\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-functions-key",
                "value": "{{functionKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Test Cappuccino\",\n  \"price\": 35.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/menu/{{menuCategory}}/{{menuSku}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu",
                "{{menuCategory}}",
                "{{menuSku}}"
              ]
            }
          }
        },
        {
          "name": "Delete Menu Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Menu delete endpoint requires Function authentication\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-functions-key",
                "value": "{{functionKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/menu/{{menuCategory}}/{{menuSku}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu",
                "{{menuCategory}}",
                "{{menuSku}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Staff Documents",
      "item": [
        {
          "name": "Upload Staff Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Document upload succeeds\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Upload response confirms the file name\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.fileName).to.eql(pm.environment.get(\"documentFileName\"));",
                  "});",
                  "",
                  "pm.test(\"Upload response confirms PDF content type\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.contentType).to.eql(\"application/pdf\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "upload"
              ]
            }
          }
        },
        {
          "name": "List Staff Documents",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Document list request succeeds\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Document list returns an array\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Uploaded document appears in the list\", function () {",
                  "    const json = pm.response.json();",
                  "    const fileName = pm.environment.get(\"documentFileName\");",
                  "    pm.expect(",
                  "        json.some(document => document.fileName === fileName)",
                  "    ).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            }
          }
        },
        {
          "name": "Download Staff Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Document download succeeds\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Downloaded document is a PDF\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/pdf\");",
                  "});",
                  "",
                  "pm.test(\"Downloaded response contains data\", function () {",
                  "    pm.expect(pm.response.body).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/documents/download/{{documentFileName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "download",
                "{{documentFileName}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Validation & Error Cases",
      "item": [
        {
          "name": "Upload Without File",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Upload without a file is rejected\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": []
            },
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "upload"
              ]
            }
          }
        },
        {
          "name": "Download Missing Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Missing document returns not found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/documents/download/missing-document.pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "download",
                "missing-document.pdf"
              ]
            }
          }
        },
        {
          "name": "Upload Duplicate Staff Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Duplicate document upload is rejected\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "test-data/valid-staff-test.pdf"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "upload"
              ]
            }
          }
        }
      ]
    }
  ]
}